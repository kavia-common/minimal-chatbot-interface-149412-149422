# PUBLIC_INTERFACE
# Environment variables for the Gemini Chatbot frontend (Vite).
# Copy this file to ".env" and adjust as needed.

# URL for the backend FastAPI server. If not set, the app defaults to http://localhost:3001.
# Example:
# VITE_BACKEND_URL=https://your-backend.example.com
# VITE_BACKEND_URL=http://localhost:3001
