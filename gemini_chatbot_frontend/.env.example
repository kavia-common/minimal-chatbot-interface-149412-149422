# Example environment variables for the Gemini Chatbot frontend

# Backend base URL (recommended absolute URL), e.g.:
# http://localhost:3001
# https://your-domain.example.com
# If omitted during development, the app will:
#  - Use the Vite dev proxy for /chat when running on port 3000
#  - Or fall back to window.location.origin but with port 3001
VITE_BACKEND_URL=
