# Frontend environment variables

# VITE_BACKEND_URL
# Absolute base URL to the FastAPI backend.
# - For local development (backend on port 3001), you can set:
#     VITE_BACKEND_URL=http://localhost:3001
# - In cloud preview, do NOT rely on the dev proxy. Set this to the backend URL:
#     VITE_BACKEND_URL=https://vscode-internal-33666-beta.beta01.cloud.kavia.ai:3001
# If omitted:
# - Local dev (localhost:3000) will use the Vite proxy for /chat -> http://localhost:3001
# - Non-local hosts will default to the same host but forced port 3001
#   (e.g., https://<preview-host>:3001)
VITE_BACKEND_URL=

# Optional: other app variables
# Provided for reference; not used directly in this frontend code.
REACT_APP_GEMINI_API_KEY=
